# Generated from src/Makevars.in by ./configure (or ./configure.win).
# Do not edit src/Makevars -- edit this file.
#
# R compiles src/ top level and not subdirectories, so the vendored solver has
# to be listed explicitly. The block below is generated by tools/objects.sh,
# which tools/vendor.sh runs, so bumping OpenSMT updates the build with it.

CXX_STD = CXX20

# -Iopensmt because upstream includes its own headers as <api/Foo.h>,
# <minisat/mtl/Vec.h> and so on, relative to its source root; sibling headers
# resolve on their own through the quoted-include rules.
PKG_CPPFLAGS = -I. -Iopensmt @GMP_CFLAGS@
PKG_CXXFLAGS = @PTHREAD@
PKG_LIBS = @GMP_LIBS@ @PTHREAD@

# >>> generated by tools/objects.sh -- do not edit by hand
